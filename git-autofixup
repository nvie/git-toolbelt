#!/bin/sh
set -e

make_relative () {
    while read f; do
        git relative-path "$f"
    done
}

# `--diff-filter=a` excludes newly-added files (no prior commit to fix up).
FILES="$(git diff --cached --name-only --diff-filter=a | make_relative)"
if [ -z "$FILES" ]; then
  echo "No staged files found that have previously been committed." >&2
  exit 2
fi

SHA="$(git last-commit-to-file $FILES)"

if [ -n "$SHA" ]; then
  git commit --fixup "$SHA" --no-verify
else
  echo "Could not determine which commit last touched the staged files." >&2
  exit 3
fi
