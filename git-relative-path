#!/bin/sh
set -e

root="$(git root)"
# Use the first realpath that supports --relative-to (GNU coreutils does, and
# so does uutils, but the BSD one on macOS doesn't)
realpath_bin=""
found=""
for candidate in grealpath realpath; do
    if command -v "$candidate" >/dev/null 2>&1; then
        found="$candidate"
        if "$candidate" --relative-to=. . >/dev/null 2>&1; then
            realpath_bin="$candidate"
            break
        fi
    fi
done

if [ -z "$found" ]; then
    echo "'realpath' or 'grealpath' utility not found. Please install GNU coreutils." >&2
    exit 1
fi

if [ -z "$realpath_bin" ]; then
    echo "No 'realpath' found that supports --relative-to." >&2
    echo "Please install GNU coreutils and try again." >&2
    exit 2
fi

while [ $# -gt 0 ]; do
    path="$("$realpath_bin" --relative-to=. "$root/$1")"

    # Keep names like "-rf" or "+cmd" from being parsed as options or
    # commands when the output is passed on a command line.
    case "$path" in
        -*|+*) path="./$path";;
    esac
    printf '%s\n' "$path"
    shift
done
