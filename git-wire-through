#!/bin/sh
set -eu

usage () {
    echo "usage: git wire-through [-h] [--base=<base>] [-m <msg>] <command...>" >&2
    echo >&2
    echo "Runs <command> after every commit in <base>..HEAD and folds the" >&2
    echo "results back into each commit, as if the command had always been" >&2
    echo "applied." >&2
    echo >&2
    echo "The command also runs once on the base commit itself. If that" >&2
    echo "produces changes, they are kept as a new first commit titled" >&2
    echo "\"Ran '<command>'\" (or <msg>, if -m is given); if not, no extra" >&2
    echo "commit is created." >&2
    echo >&2
    echo "The command runs in the current working directory, but any side" >&2
    echo "effects elsewhere in the repo are also captured." >&2
    echo >&2
    echo "Arguments:" >&2
    echo "  <command...>  All remaining arguments are joined and run as a single" >&2
    echo "                shell command, e.g.: git wire-through prettier --write ." >&2
    echo >&2
    echo "Options:" >&2
    echo "  --base=<ref>  Base commit (default: merge-base with upstream tracking branch)" >&2
    echo "  -m <msg>      Commit message for the leading base commit, if one is" >&2
    echo "                created (default: \"Ran '<command>'\")" >&2
    echo "  -h, --help    Show this help" >&2
    exit 2
}

# Parse options
base=""
message=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage ;;
        --base=*) base="${1#--base=}"; shift ;;
        --base)
            if [ $# -lt 2 ]; then
                echo "error: --base requires a value" >&2
                exit 1
            fi
            base="$2"; shift 2 ;;
        -m)
            if [ $# -lt 2 ]; then
                echo "error: -m requires a value" >&2
                exit 1
            fi
            message="$2"; shift 2 ;;
        *) break ;;
    esac
done

if [ $# -eq 0 ]; then
    usage
fi

command="$*"

if [ -z "$message" ]; then
    message="Ran '$command'"
fi

# Guards
git is-clean -v

original_branch="$(git current-branch)"
original_sha="$(git sha HEAD)"

# Default base: merge-base with upstream tracking branch
if [ -z "$base" ]; then
    base="$(git merge-base HEAD "@{upstream}")"
fi

# Record cwd relative to repo root
root="$(git rev-parse --show-toplevel)"
current_dir="$(pwd -P)"
if [ "$current_dir" = "$root" ]; then
    wire_through_cwd="."
else
    wire_through_cwd="${current_dir#"$root"/}"
fi

tmp_branch="tmp-wire-through/$original_branch"

rebase_in_progress () {
    [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]
}

# Ensure temp branch doesn't already exist
if git local-branch-exists "$tmp_branch"; then
    echo "error: temp branch '$tmp_branch' already exists, probably left behind by an interrupted run" >&2
    echo "To remove it:" >&2
    if rebase_in_progress; then
        echo "  git rebase --quit" >&2
    fi
    echo "  git branch -D $tmp_branch" >&2
    exit 1
fi

# Checks inside cleanup() use git builtins only: dashed externals (like
# git local-branch-exists) run under a git wrapper that installs its own
# SIGINT handler, so a second Ctrl+C would still kill them.
tmp_branch_exists () {
    git show-ref --heads --quiet --verify -- "refs/heads/$tmp_branch"
}

# Cleanup trap: runs on every exit. Unless the run succeeded, restores the
# original branch. Always removes the temp branch, and prints the manual
# steps for whatever could not be restored.
succeeded=0
author_info=""
cleanup () {
    status=$?
    trap '' INT TERM HUP

    if [ -n "$author_info" ]; then
        rm -f "$author_info"
    fi

    if [ "$succeeded" -eq 0 ]; then
        echo "" >&2
        if [ "$status" -gt 128 ]; then
            echo "wire-through interrupted, restoring $original_branch..." >&2
        else
            echo "wire-through failed, restoring $original_branch..." >&2
        fi
        if rebase_in_progress && ! git rebase --abort; then
            echo "warning: 'git rebase --abort' failed, falling back to 'git rebase --quit'" >&2
            git rebase --quit || true
        fi
        git checkout -q -f "$original_branch" || true
    fi

    if tmp_branch_exists; then
        git branch -q -D "$tmp_branch" || true
    fi

    # Verify the end state rather than trusting the steps above
    todo=""
    if rebase_in_progress; then
        todo="$todo  git rebase --quit\n"
    fi
    if [ "$(git symbolic-ref -q --short HEAD || true)" != "$original_branch" ]; then
        todo="$todo  git checkout -f $original_branch\n"
    fi
    if [ "$succeeded" -eq 0 ] && [ "$(git rev-parse -q --verify "refs/heads/$original_branch")" != "$original_sha" ]; then
        todo="$todo  git reset --hard $original_sha\n"
    fi
    if tmp_branch_exists; then
        todo="$todo  git branch -D $tmp_branch\n"
    fi

    if [ -n "$todo" ]; then
        echo "" >&2
        echo "error: could not fully restore the repo. To finish manually, run:" >&2
        printf '%b' "$todo" >&2
    elif [ "$succeeded" -eq 0 ]; then
        echo "$original_branch is unchanged at $original_sha." >&2
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# Create temp branch
git checkout -q -b "$tmp_branch"

# Save original commit hashes (author info will be read from them later)
author_info="$(mktemp)"
git log --reverse --format='%H' "$base"..HEAD > "$author_info"

# Pass 1: inject command after each commit
export GIT_WIRE_THROUGH_COMMAND="$command"
export GIT_WIRE_THROUGH_CWD="$wire_through_cwd"
export GIT_WIRE_THROUGH_MESSAGE="$message"
GIT_SEQUENCE_EDITOR="git wire-through--inject" git rebase -i --empty=keep "$base"

# Pass 2: collapse [fixup-wire-through] commits
export GIT_WIRE_THROUGH_AUTHOR_INFO="$author_info"
GIT_SEQUENCE_EDITOR="git wire-through--collapse" git rebase -i --empty=keep "$base"

# Success: move original branch forward (the trap removes the temp branch)
result_sha="$(git sha HEAD)"
git checkout -q -B "$original_branch" "$result_sha"
succeeded=1

echo "Done. All commits in $original_branch now include effects of: $command"
echo ""
echo "  before: $original_sha"
echo "  after:  $result_sha"
echo ""
echo "To verify:  git diff $original_sha..$result_sha"
echo "To revert:  git reset --hard $original_sha"
